# Copy to a PRIVATE ignored .env file. Explicit file settings override inherited
# config; process API credentials take priority and are never printed/saved.
# This default is explicitly synthetic; no SDK / inference network is constructed.
PROVIDER=local_stub
LLM_BILLING_MODE=unmetered
CONTROLS_DEPLOYMENT_ID=controlled-local-installation
TUTOR_PACK=datascience
LLM_TIMEOUT_SECONDS=30

# Optional one-time local validation (disabled by default):
# Duration is a local test-policy choice, not a model or login-token requirement.
# Bounded mode supports up to 7200 seconds; continuous development can use
# WINDOW_SECONDS=0 and EXPIRES_AT=0 with an approved finite cumulative cap.
# After prepare (new installations only), persist it with:
# .\start-belay.ps1 -UseAmountOnlyBudget
# Existing installations use their saved cap; env edits cannot replace it.
# CONTROLS_INFERENCE_WINDOW_SECONDS=3600
# CONTROLS_INFERENCE_TOTAL_MICROUNITS=operator-approved-cumulative-cap
# First start persists expiry/cap in runtime.json; restart never renews it.
# check never starts the window. Do not edit/remove its persisted authorization.

# R2 policy remains explicit; enabling saving does not enable research consent.
# Saving is still opt-in on the page. This is a synthetic local retention policy.
DIALOGUE_ENABLED=1
DIALOGUE_POLICY_ID=controlled-local-test-only
DIALOGUE_RETENTION_SECONDS=3600
DIALOGUE_BACKUP_MAX_AGE_SECONDS=3600

# Active only with PROVIDER=openai_compatible; supply endpoint/models explicitly.
# OPENAI_BASE_URL=https://your-approved-endpoint.example/v1
# MODEL_FAST=operator-selected-fast-model
# MODEL_STRONG=operator-selected-strong-model
# OPENAI_API_KEY supplied through private process environment; never in Git.
OPENAI_REASONING=0
OPENAI_THINKING_MODE=
OPENAI_RESPONSE_FORMAT=json_object
OPENAI_FINAL_CONTENT_ONLY=1

# Active only with PROVIDER=anthropic; install the optional anthropic package.
# ANTHROPIC_API_KEY supplied through private process environment; never in Git.
# ANTHROPIC_MODEL_FAST=operator-selected-fast-model
# ANTHROPIC_MODEL_STRONG=operator-selected-strong-model
ANTHROPIC_THINKING=0
ANTHROPIC_THINKING_BUDGET=2048

# Hosted inference: set LLM_BILLING_MODE=metered and provide an explicitly
# reviewed policy with positive input/output per-token microunit bounds covering
# BOTH tiers, thinking and cache. Example USD0.10/period, not a vendor invoice cap.
# COST_PER_1K_PROMPT / COMPLETION affect telemetry ONLY, not budget enforcement.
