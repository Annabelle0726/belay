# Copy to .env and fill in. Never commit real secrets.

# --- Inference provider seam -------------------------------------------------
# PROVIDER selects the inference provider; the fast/strong tier POLICY (which
# component uses which tier) is provider-agnostic and lives in core. Only the
# tier->model mapping is per-provider config below.
#   openai_compatible (default, self-hosted first-class) | anthropic | bedrock(stub)
PROVIDER=openai_compatible

# -- openai_compatible: any OpenAI-compatible endpoint (Ollama / vLLM / a JS2-
#    hosted model / MESA AI-Verde). One base_url serves all tiers; a single-model
#    endpoint may set MODEL_FAST == MODEL_STRONG. Token-free local endpoints keep
#    OPENAI_API_KEY=EMPTY (the SDK wants a non-empty string).
OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama default (zero external API)
OPENAI_API_KEY=EMPTY
MODEL_FAST=llama3.2
MODEL_STRONG=llama3.2
LLM_TEMPERATURE=0.4
# Thinking/reasoning is a model CAPABILITY — OFF by default so ordinary local
# models work. Opt in only for an endpoint serving a reasoning model (e.g. gpt-oss):
OPENAI_REASONING=0                             # 1 to send reasoning_effort
REASONING_STRONG=                              # effort when enabled (e.g. low|medium|high); strong tier only
#  Jetstream2 via its Open WebUI proxy (set a real token):
#    OPENAI_BASE_URL=https://llm.jetstream-cloud.org/api
#    OPENAI_API_KEY=<token>  MODEL_FAST=llama-4-scout  MODEL_STRONG=gpt-oss-120b  REASONING_STRONG=high

# -- anthropic (hosted convenience; needs the anthropic package + a key):
#    PROVIDER=anthropic
#    ANTHROPIC_API_KEY=sk-ant-...
#    ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
#    ANTHROPIC_MODEL_STRONG=claude-sonnet-4-6
#    ANTHROPIC_THINKING=1                       # extended thinking (default on)
#    ANTHROPIC_THINKING_BUDGET=2048             # thinking token budget

# -- bedrock (documented STUB; not live). Amazon Nova mapping:
#    BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0  BEDROCK_MODEL_STRONG=amazon.nova-pro-v1:0

# -- cost telemetry (per-1k tokens, USD; 0 for self-hosted). See Workstream C.
COST_PER_1K_PROMPT=0
COST_PER_1K_COMPLETION=0

# --- Active teaching domain pack ---------------------------------------------
# Selects the DomainPack the core loop runs (core/domain registry).
# datascience (default) | _skeleton (echo, for tests).
TUTOR_PACK=datascience

# --- Persistence: sql (durable) | memory (ephemeral, dev only) ---------------
STORE_BACKEND=sql
DATABASE_URL=sqlite:///./qimvp.db
# Pilot example:
# DATABASE_URL=postgresql+psycopg://qi:qi@db:5432/qimvp

# --- Self-evaluation refine cap (abstain/refine loop) ------------------------
MAX_REFINE=1

# --- CORS origins for the front-end ------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
