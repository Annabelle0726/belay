# Copy to .env and fill in. Never commit real secrets.

# --- Model layer: Jetstream2 Inference Service (default) ---------------------
# US-origin, open-weight models hosted at IU. OpenAI-compatible. No per-token
# cost, and the service consumes no Jetstream2 SUs.
LLM_PROVIDER=jetstream

# Tier -> model id (served names on the JS2 inference service):
MODEL_FAST=llama-4-scout
MODEL_STRONG=gpt-oss-120b
REASONING_STRONG=high            # gpt-oss effort: low | medium | high

# Per-tier OpenAI-compatible base URLs.
#  * ON a Jetstream2 / IU Research Cloud instance: use these direct endpoints
#    (no token needed; access is restricted to JS2/IU networks).
#  * OFF-instance (local dev): point BOTH at the Open WebUI proxy and set
#    LLM_API_KEY to a token you generate in the chat UI:
#       LLM_BASE_FAST=https://llm.jetstream-cloud.org/api
#       LLM_BASE_STRONG=https://llm.jetstream-cloud.org/api
LLM_BASE_FAST=https://llm.jetstream-cloud.org/llama-4-scout/v1
LLM_BASE_STRONG=https://llm.jetstream-cloud.org/gpt-oss-120b/v1

# Direct on-instance access needs no token; the OpenAI SDK still wants a
# non-empty string. Set a real token only when using the Open WebUI proxy.
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.4

# --- Alternate provider (off-JS2 dev / ceiling comparison) -------------------
# Set LLM_PROVIDER=anthropic and MODEL_FAST/MODEL_STRONG to Claude model ids,
# then provide a key:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Quantum execution: local (offline simulator) | classiq (real platform) --
QUANTUM_BACKEND=local

# --- Persistence: sql (durable) | memory (ephemeral, dev only) ---------------
STORE_BACKEND=sql
DATABASE_URL=sqlite:///./qimvp.db
# Pilot example:
# DATABASE_URL=postgresql+psycopg://qi:qi@db:5432/qimvp

# --- Self-evaluation refine cap (abstain/refine loop) ------------------------
MAX_REFINE=1

# --- CORS origins for the front-end ------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
